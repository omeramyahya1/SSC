{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSC",
  "version": "0.1.1-beta.4",
  "identifier": "com.omeramyahya.ssc",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SSC",
        "width": 800,
        "height": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "src/splash.html",
        "title": "SSC",
        "width": 400,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "python-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../.env",
      "../.env.beta",
      "../.env.production",
      "../src-python/.env"
    ]
  },

  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/omeramyahya1/SSC/beta/latest-beta.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGODA1N0UzQzM3MzA5RjMKUldUekNYUEQ0MWVBSDcyVTdZMGo5V1luMUVkWHFWZjFuai9melhranNKaGtqZVM4YkRJa1dVRlcK"
    }
  }
}
