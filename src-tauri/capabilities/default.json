{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    "allow-app-commands",
    "opener:allow-open-url",
    "dialog:allow-save",
    "fs:allow-write-file",
    "process:default",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "python-sidecar",
          "sidecar": true,
          "args": [
            { "string": "--port" },
            { "validator": "\\d+" },
            { "string": "--mode" },
            { "validator": "^(dev|beta|prod)$" }
          ]
        }
      ]
    }
  ]
}
