{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "dialog:allow-save",
    "fs:allow-write-file",
    "process:default",
    "updater:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "args": [],
          "sidecar": "python-sidecar"
        }
      ]
    }
  ]
}
